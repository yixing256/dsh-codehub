# ---------------------------------------------------------------------------
# dsh-codehub — environment variable template.
#
# Copy to `.env` and fill in your own values. `.env` is gitignored (.gitignore:
# `.env`, `.env.*`) — NEVER commit it, and never paste a real token into this
# template. Every value below is intentionally EMPTY.
#
# Empty = not configured. What that costs you:
#   * GitHub: anonymous api.github.com works but hits the low rate limit fast.
#   * Gitee:  the v5 search endpoints answered empty for anonymous callers in
#             local testing, so a token is effectively required.
#   * CSDN:   public search answers without a cookie; the cookie only helps
#             with logged-in-only content.
# ---------------------------------------------------------------------------

# GitHub personal access token (raises the rate limit, allows private repos).
# Sent ONLY to the official api.github.com. Any request routed through
# ghproxy / raw-mirror / a third-party mirror has the token stripped by the
# request builder (see src/contract.ts: TOKEN_FORBIDDEN_ACCESS).
DSH_CODEHUB_GITHUB_TOKEN=

# Gitee personal access token (v5 /search/* needs authentication).
DSH_CODEHUB_GITEE_TOKEN=

# CSDN cookie (optional). Used against the so.csdn.net v3 internal search
# endpoint, which is not a public API and may break without notice —
# see the "接口稳定性" section of README.md.
DSH_CODEHUB_CSDN_COOKIE=
