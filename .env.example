# ---------------------------------------------------------------------------
# dsh-codehub — environment variable template.
#
# Copy to `.env` and fill in your own values. `.env` is gitignored (.gitignore:
# `.env`, `.env.*`) — NEVER commit it, and never paste a real token into this
# template. Every value below is intentionally EMPTY.
#
# Empty = not configured. What that costs you (measured 2026-10-04, see README):
#   * GitHub: anonymous repository search and file reads work; CODE SEARCH does
#             not (anonymous /search/code answers HTTP 401), so a token is
#             required for code results.
#   * Gitee:  /api/v5/search/repositories answers `[]` for anonymous callers, so
#             a token is effectively required for repository results. Note that
#             v5 has NO code-search endpoint at all (HTTP 404) — a token cannot
#             fix that.
#   * CSDN:   search answers anonymously, but most rows carry no body text; the
#             article page has the code. Its session cookie raises the success
#             rate against the HTTP 521 anti-bot gate.
# ---------------------------------------------------------------------------

# GitHub personal access token (raises the rate limit, allows private repos,
# and is required for code search). Sent ONLY to the official api.github.com.
# Any request routed through ghproxy / raw-mirror / a third-party mirror has the
# token stripped by the request builder (see src/contract.ts:
# TOKEN_FORBIDDEN_ACCESS).
DSH_CODEHUB_GITHUB_TOKEN=

# Gitee personal access token (v5 /search/repositories needs authentication).
DSH_CODEHUB_GITEE_TOKEN=

# CSDN cookie (optional). Used against the so.csdn.net v3 internal search
# endpoint, which is not a public API and may break without notice —
# see the "接口稳定性" section of README.md. so.csdn.net/robots.txt declares
# `Disallow: /`: this plugin issues ONE request per user-triggered action and
# never crawls.
DSH_CODEHUB_CSDN_COOKIE=

# Gitee OAuth client secret — only needed if you use the browser (authorization
# code) login instead of a personal access token. Gitee requires a client secret
# (it supports neither PKCE nor a device flow), so the value you created on
# https://gitee.com/oauth/applications goes here and NOWHERE else: it is a
# credential, never a config field, never committed, never echoed by the UI.
DSH_CODEHUB_GITEE_OAUTH_CLIENT_SECRET=
